# Copy to .env and adjust. `docker compose up db` provisions Postgres with
# the ragops/ragops credentials below (see docker-compose.yml).

# Environment & Logging
ENV=development
LOG_LEVEL=INFO
JSON_LOGS=true

# PostgreSQL (matches the db service in docker-compose.yml)
DATABASE_URL=postgresql://ragops:ragops@localhost:5432/ragops

# Vector Store (Qdrant)
VECTOR_STORE_PROVIDER=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=

# LLM & Embeddings
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50